# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/gvmc_opendata

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS Configuration
CLIENT_ORIGIN=http://localhost:5173

# Admin Initial Credentials for Seeding
DEFAULT_ADMIN_EMAIL=admin@gvmc.gov.in
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_NAME=GVMC Data Administrator

# Max File Upload Size (in bytes, 50MB default)
MAX_FILE_SIZE=52428800
